> ^ cap \\\\`x %% hidden
%%               ^^^^^^^^^ carveLineVerbatim

%% THE CONVERGED SPELLINGS (markup-carve/carve#2775). A selector needs no
%% whitespace before its `#`, and an option none before its `@`, so a path
%% pattern that stopped only at a SPACE would swallow the marker and hand the
%% rest to the tag and mention rules - the shredding this region exists to
%% prevent. The path run stops at `#`, `@`, `}` and whitespace alike, so these
%% hold without a rule per spelling. Pinned because every selector case above
%% is written WITH the space, so none of them could see this.
Tight: {{ part.crv#intro }} done.
%%          ^^^^^^^^ carveIncludePath
%%                  ^^^^^^ carveIncludeSection

%% A QUOTED path closes on its own quote, so the marker may touch it.
Quoted: {{ "a part.crv"#intro }} done.
%%           ^^^^^^^^^^^^ carveIncludePath
%%                       ^^^^^^ carveIncludeSection

%% An OPTION with no pad before `@`.
Option: {{ part.crv@fmt:raw }} done.
%%           ^^^^^^^^ carveIncludePath
%%                   ^^^^ carveIncludeOptionName
%%                        ^^^ carveIncludeOptionValue

%% A selector and an option, the option touching the selector.
Both: {{ part.crv #Intro@fmt:raw }} done.
%%         ^^^^^^^^ carveIncludePath
%%                  ^^^^^^ carveIncludeSection
%%                        ^^^^ carveIncludeOptionName

%% A selector keeps its case: ids compare case exactly (carve 0.1.8), so
%% `#Intro` and `#intro` are different selectors and neither is normalized
%% here. The scope is the same either way; what matters is that the region
%% claims both rather than leaving one to the tag rule.
Case: {{ part.crv#Intro }} and {{ part.crv#intro }}.
%%                 ^^^^^^ carveIncludeSection
%%                                          ^^^^^^ carveIncludeSection

%% EDITOR AUDIT (2026-10): paragraph context, captions, flanking, quotes.

%% A list marker or a caption does not interrupt a paragraph.
para
- not a list
^ not a caption
%%^^^^^ (none)

para
- not a list
%%^ (none)

para
1. not a list
%%^^ (none)

%% A marker after a lazy continuation line opens the next item.
- a
lazy
- b
%%^ carveListBullet

%% After a blank line the marker opens a list.
para

- a
%%^ carveListBullet

%% A marker deeper in a list item opens a nested list.
- a
  more
  - b
%%  ^ carveListBullet

%% A heading and a definition indented into a list item are blocks.
- a

  # Inner
%%  ^^^^^^^ carveListHeading

- a

  :: term
%%  ^^^^^^^ carveListDefTerm

%% A caption takes a host block: not a heading, a paragraph or nothing.
# H
^ literal
%%^^^^^^^^^ (none)

para

^ literal
%%^^^^^^^^^ (none)

| t |

%% After a blank line a caret line is text (C2-B-149, U-063).
^ cap
%%^^^^^ (none)

```
x
```
^ cap
%%^^^^^ carveCaption

> q
^ cap
%%^^^^^ carveCaption

%% A bare delimiter needs a word boundary on the outside.
snake_case_name a/b/c 2*3*4 key=value=x a~b~c http://x/a/b
%%     ^^^^^^ (none)
%%                 ^^^ (none)
%%                       ^^^ (none)
%%                               ^^^^^^^ (none)
%%                                         ^^^ (none)
%%                                                   ^^^^^^^ (none)

a ==x== b and *real* bold
%%  ^^^^^ (none)
%%               ^^^^ carveBold

*word*_
%% ^^^^ carveBold

%% A run may cross one line break, and a code span too; an opener with no
%% closer on its line or the next opens nothing.
an /italic
run/ and `code
%%^^^ carveItalic
%%          ^^^^ (none)

a `code
span` b
%%^^^^ carveCode

%% Arrows: `=>` is literal, `-->` and `==>` convert, (C) and (c) do not
%% (carve#4808).
a --> b ==> c => d (C) (c)
%%  ^^^ carveTypography
%%        ^^^ carveTypography
%%              ^^ (none)
%%                   ^^^ (none)
%%                       ^^^ (none)

%% `->`, `<-` and `<->` stay text, and an arrow needs its exact hyphen run:
%% `a<---b` is `<` and an em dash (carve#4815). (tm) still converts.
x->y a<-b <-> a<---b (tm)
%% ^^ (none)
%%      ^^ (none)
%%          ^^^ (none)
%%               ^ (none)
%%                ^^^ carveTypography
%%                     ^^^^ carveTypography

%% `%%` opens a comment after a space only.
50%% off, a	%% tab, and %% hidden
%%^^^^^^^^ (none)
%%            ^^^^^^ (none)
%%                        ^^^^^^^^^ carveComment

%% Definitions keep their line from the link rule.
[ref]: http://x
%%^^^^^ carveRefLabel

[^f]: note
%%    ^^^^^^ carveFootDef

%% A table row ends in a pipe.
| a | b
%%^^^^^^^ (none)

%% Blocks inside a quote.
> # Quoted
%%  ^^^^^^^^ carveQuotedHeading

> - item
%%  ^ carveQuotedListMarker

> :: term
%%  ^^^^^^^ carveQuotedDefTerm

> | x |
%%   ^^^ carveQuotedTable

> ::: note
%%  ^^^ carveQuotedDivFence
%%      ^^^^ carveAdmonition

%% A quoted fence keeps its body verbatim and ends with its quote.
> ```
> *x*
%%  ^^^ carveQuotedCodeBlock

> ```
> ```
> after *b*
%%         ^ carveBold

%% A header cell's `|=` marker is the header. A glued `<` or `>` after it is
%% cell text in Carve 0.2 (U-056).
|=< A |=> B |
%%^^ carveTableHeader
%%  ^ carveTable
%%    ^ carveTable
%%      ^^ carveTableHeader
%%        ^ carveTable
%%          ^ carveTable

%% A letter or roman marker with a dot needs two spaces (carve#4828).
A. Smith wrote
%%^^ (none)

a.  item
%%^^ carveListNumber

%% A mention or tag name holds an ASCII letter (carve#4809).
x @5 #123 @a1 #v2
%%  ^^ (none)
%%     ^^^^ (none)
%%          ^^^ carveMention
%%              ^^^ carveTag

%% Braced cell alignment (carve#5091): the block is the cell's attributes.
|={>} Price |={< .x} Item |
%%^^ carveTableHeader
%%  ^^^ carveTableCellAttr
%%              ^^^^^^ carveTableCellAttr
%%                     ^^^^ carveTable

%% ---------------------------------------------------------------------------
%% CARVE 0.2. `=` marks a heading beside `#` (C2-B-151, C2-B-152). Only a code
%% fence, a `:::` fence, a `%%%` comment fence, a table row and a `***` break
%% end a paragraph; any other block opener under text is text (U-001 to
%% U-010), and a `%%` comment line keeps the paragraph open.
%% ---------------------------------------------------------------------------

= Title
%%^^^^^^^ carveHeading1

=== Third
%%^^^^^^^^^ carveHeading3

text
# not a heading
%%^^^^^^^^^^^^^^^ (none)
= not a heading
%%^^^^^^^^^^^^^^^ (none)
> not a quote
%%^ (none)
:: not a term
%%^^ (none)
[x]: /not-a-definition
%%    ^ (none)

text
%% a comment line
# still text
%%^ (none)

text
***
%%^^^ carveRule
# a heading again
%%^^^^^^^^^^^^^^^^^ carveHeading1

| row |
# after a table row
%%^^^^^^^^^^^^^^^^^^^ carveHeading1

%% ---------------------------------------------------------------------------
%% A BLOCK OPENER OUTRANKS THE INLINE RULE THAT STARTS AT THE SAME COLUMN.
%%
%% Vim gives the LAST-DEFINED item priority on a tie, so carveCode (start /`/)
%% used to claim a ``` fence line and carveStrike (start /~/) a ~~~ one. The
%% fence then never opened, the emphasis rules ran inside the code, and
%% `x = *not bold*` was coloured bold. Nothing looked inside a fence, so
%% nothing failed.
%% ---------------------------------------------------------------------------

```text
%%^ carveCodeFence
x = *not bold* and `not code`
%%^ carveCodeBlock
%%    ^ carveCodeBlock
%%                   ^ carveCodeBlock
```
%%^ carveCodeFence

~~~
%%^ carveCodeFence
y = ~not struck~
%%    ^ carveCodeBlock
~~~
%%^ carveCodeFence

%% A RAW PASSTHROUGH BLOCK is a code fence whose info string is =FORMAT. It
%% is its own construct and its payload is handed to that format untouched.
```=html
%%^ carveCodeFence
%%   ^ carveCodeInfo
%%    ^^^^ carveRawFormat
<b>*not bold*</b>
%%   ^ carveRawBlock
```
%%^ carveCodeFence

```math
%%^ carveCodeFence
E = *m*c^2
%%    ^ carveMathBlock
```
%%^ carveCodeFence

%% ---------------------------------------------------------------------------
%% THE INFO STRING ON A FENCE OPENER IS AN ITEM OF ITS OWN.
%%
%% The language, the raw =FORMAT, the quoted title and the [Label] each carry
%% their own group. They used to reach for the opener through
%% `containedin=carveCodeFence`, which names a matchgroup rather than a
%% container, so nothing could be contained in it and all four came out the
%% same colour as the backticks.
%% ---------------------------------------------------------------------------

```text "Header" [Label]
%%^ carveCodeFence
%%   ^^^^ carveCodeLang
%%       ^ carveCodeInfo
%%        ^^^^^^^^ carveCodeTitle
%%                ^ carveCodeInfo
%%                 ^^^^^^^ carveCodeLabel
x = 1
%%^ carveCodeBlock
```
%%^ carveCodeFence

%% The title and the label live on the OPENER LINE, not in the region, so a
%% quoted string in the payload stays payload.
```text
%%^ carveCodeFence
s = "not a title" [not a label]
%%     ^ carveCodeBlock
%%                   ^ carveCodeBlock
```
%%^ carveCodeFence

%% ---------------------------------------------------------------------------
%% A CODE FENCE CLOSES ON ITS OWN CHARACTER, AT LEAST AS LONG AS ITS OPENER.
%%
%% The closer used to be any bare ``` line, so a four-backtick fence holding a
%% Carve sample ended at the sample's own closer, and a longer closer did not
%% close at all.
%% ---------------------------------------------------------------------------

````carve
%%^^^^ carveCodeFence
```js
%%^ carveCodeBlock
```
%%^ carveCodeBlock
still inside the outer fence
%%^ carveCodeBlock
````
%%^^^^ carveCodeFence
after the outer fence
%%^ (none)

```
a
%%^ carveCodeBlock
````
%%^^^^ carveCodeFence
after a longer closer
%%^ (none)

~~~~
~~~
%%^ carveCodeBlock
```
%%^ carveCodeBlock
~~~~~
%%^^^^^ carveCodeFence
after the tilde fence
%%^ (none)

%% ---------------------------------------------------------------------------
%% A FENCE BODY TAKES ITS LANGUAGE'S SYNTAX when Vim has a syntax file for it
%% and the tag is in g:carve_fenced_languages (see tests/fenced-off.crv for an
%% empty list).
%% ---------------------------------------------------------------------------

```js
%%^ carveCodeFence
%%   ^^ carveCodeLang
const n = 1;
%%          ^ javaScriptNumber
```
%%^ carveCodeFence

~~~py
x = 1
%%    ^ pythonNumber
~~~
%%^ carveCodeFence

%% The info string stays the fence's even where the embedded syntax has a rule
%% that starts at the same column.
```yml
%%   ^^^ carveCodeLang
key: 1
%%     ^ yamlInteger
```
%%^ carveCodeFence

%% A thematic break is a whole line of dashes, stars or underscores; the
%% typography rule claims the first two dashes and the emphasis regions the
%% stars and underscores.
---
%%^ carveRule
***
%%^ carveRule
___
%%^ carveRule

%% ---------------------------------------------------------------------------
%% EVERY VERBATIM PAYLOAD IS INERT.
%%
%% The construct ledger tracks two things per construct - is it recognized,
%% and does it keep its payload inert. A live marker inside each payload is
%% the measurement: if it comes back scoped as emphasis the row leaks, which
%% is worse than unhighlighted because the colour claims something false.
%% ---------------------------------------------------------------------------

%% A line comment is written indented here only because this harness reads
%% an unindented %% line as one of its own assertion lines.
 %% a *not bold* line comment
%%      ^ carveComment

text %% a *not bold* trailing comment
%%          ^ carveComment

 %%%%
%% ^ carveCommentFence
a *not bold* line inside a comment block
%%  ^ carveCommentBlock
 %%%%
%% ^ carveCommentFence

a `*not bold*` code span
%%   ^ carveCode

a !`*not bold*` inline literal
%%    ^ carveLiteralInline

a `x`{=html} raw inline
%%  ^ carveRawInline

a $`*not bold*` inline math
%%    ^ carveMathInline

$$`*not bold*`
%%   ^ carveMathDisplay

a {% *not bold* %} braced comment
%%     ^ carveCommentInline

a {# *not bold* #} editorial comment
%%     ^ carveCriticCom

a <https://x.test/*not*> autolink
%%                  ^ carveUrl

%% ---------------------------------------------------------------------------
%% CONSTRUCTS THAT HAD NO RULE OF THEIR OWN.
%% ---------------------------------------------------------------------------

A /*bold italic*/ run.
%%  ^ carveBoldItalic
%%               ^ carveBoldItalic

Forced {*bold*} {/italic/} {_under_} {~strike~} {=mark=} spellings.
%%       ^ carveForcedBold
%%                ^ carveForcedItalic
%%                           ^ carveForcedUnderline
%%                                     ^ carveForcedStrike
%%                                                ^ carveForcedHighlight

%% A mismatched brace pair closes nothing and is literal text; the single
%% rule these five replaced accepted it.
Not emphasis: {/x*} here.
%%              ^ (none)

![alt][ref] and ![alt][] images.
%%^ carveReferenceImage
%%                ^ carveCollapsedImage

::: |
%%^ carveLineBlock
one line per stanza line
:::
%%^ carveDivFence

:::: \
%%^ carveLocalHardBreak
a local hard-break block
::::
%%^ carveDivFence

::: >
%%^ carveFencedQuote
the third sigil builds a quote
:::
%%^ carveDivFence

%% ---------------------------------------------------------------------------
%% THE RESERVED INCLUDE DIRECTIVE (PART 9 S19).
%%
%% The point of these is the NEGATIVE half: `#intro` must not be carveTag and
%% `@fmt:raw` must not be carveMention, because a directive is not spelled out
%% of the constructs its own selector happens to look like.
%% ---------------------------------------------------------------------------

See {{ chapters/intro.crv #intro }} here.
%%    ^ carveIncludeDelim
%%         ^ carveIncludePath
%%                          ^ carveIncludeSection
%%                            ^ carveIncludeSection
%%                                 ^ carveIncludeDelim

Options: {{ part.crv @fmt:raw }} done.
%%             ^ carveIncludePath
%%                      ^ carveIncludeOptionName
%%                         ^ carveIncludeOption
%%                           ^ carveIncludeOptionValue

%% Both pads are required, so `{{path}}` is ordinary text and the tag rule is
%% free to claim a `#word` that really is one.
Literal {{path#intro}} and a real #tag.
%%              ^ (none)
%%                                  ^ carveTag

%% AN OPTION VALUE IS AN `attribute_value` (PART 9 S19), so it may be quoted,
%% and a quoted one carries spaces. Read as a run of non-space characters it
%% scoped `"two` and left `words"` out of the option (vim-carve#35, upstream
%% carve-grammars#411).

Quoted: {{ part.crv @label:"two words" }} done.
%%                           ^^^^^^^^^^^ carveIncludeOptionValue

Single: {{ part.crv @label:'two words' }} done.
%%                           ^^^^^^^^^^^ carveIncludeOptionValue

%% Each quote character admits the other one inside it.
Other: {{ part.crv @label:"it's here" }} done.
%%                          ^^^^^^^^^^^ carveIncludeOptionValue

%% A colon INSIDE a quoted value belongs to the value: the rule anchors on the
%% option's own colon, and a lookbehind on a bare colon started a second value
%% at this one.
Colon: {{ part.crv @label:"a:b c" }} done.
%%                          ^^^^^^^ carveIncludeOptionValue

%% A `}` inside a quoted value stays in the value. The region ends at ` }}`,
%% not at a bare brace, so nothing here has to widen the unquoted run.
Brace: {{ part.crv @label:"a}b" }} done.
%%                          ^^^^^ carveIncludeOptionValue

%% AN UNTERMINATED QUOTE falls back to the unquoted reading and still stops at
%% the space. It must never pair with a quote further along and paint the rest
%% of the line as an option: `words` falls out of the option entirely.
Open: {{ part.crv @label:"two words }} done.
%%                         ^^^^ carveIncludeOptionValue
%%                              ^^^^^ carveIncludePath

%% A QUOTED RUN MAY CONTAIN THE `}}` PAIR, and the directive's closer is the
%% first pair OUTSIDE one (markup-carve/carve#2013). The region used to end at
%% the pair inside the value, leaving `b" }} end` as prose.
Pair: {{ part.crv @label:"a }} b" }} end
%%                            ^^ carveIncludeOptionValue
%%                                  ^^ carveIncludeDelim
%%                                     ^ (none)

%% The PATH half closed early the same way, and the region ending mid-string is
%% what let the mention rule claim `@k` - the shredding this whole rule exists
%% to prevent.
Path: {{ "a }} b.crv" @k:v }} end
%%            ^^ carveIncludePath
%%                      ^ carveIncludeOptionName
%%                           ^^ carveIncludeDelim
%%                              ^ (none)

%% AN UNTERMINATED QUOTE opens no run, so the closer is again the FIRST pair and
%% the rest of the line is prose. This is the half the old bound got right by
%% accident, and the half a cleverer `end` pattern would have lost.
Shut: {{ part.crv @label:"two words }} end
%%                                    ^^ carveIncludeDelim
%%                                       ^ (none)

%% A quote AFTER the closer is not a run the closer can be pushed past: a skip
%% match only counts when it starts before the end match.
Apos: {{ part.crv #sec }} don't it's fine
%%                       ^^ carveIncludeDelim
%%                              ^ (none)

%% A BARE DELIMITER NEVER PAIRS ACROSS A LINK DESTINATION OR AN AUTOLINK, in
%% either direction (PART 9 S9 E2a). Parentheses in a destination nest two deep.

/see [x](http://a.b/c/) now/
%% ^^^ carveItalic
%%                        ^^^ carveItalic

/see [x](http://a/b/c) now/
%% ^^^ carveItalic
%%                       ^^^ carveItalic

/see <http://a.b/c/> now/
